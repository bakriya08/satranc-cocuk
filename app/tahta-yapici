"use client";

import { useState } from "react";
import Link from "next/link";

type TasTipi = "R" | "N" | "B" | "Q" | "K" | "P" | "r" | "n" | "b" | "q" | "k" | "p" | ".";

const BASLANGIC_TAHTASI: TasTipi[][] = [
  ["r", "n", "b", "q", "k", "b", "n", "r"],
  ["p", "p", "p", "p", "p", "p", "p", "p"],
  [".", ".", ".", ".", ".", ".", ".", "."],
  [".", ".", ".", ".", ".", ".", ".", "."],
  [".", ".", ".", ".", ".", ".", ".", "."],
  [".", ".", ".", ".", ".", ".", ".", "."],
  ["P", "P", "P", "P", "P", "P", "P", "P"],
  ["R", "N", "B", "Q", "K", "B", "N", "R"],
];

export default function TahtaYapiciPage() {
  const [tahta, setTahta] = useState<TasTipi[][]>(BASLANGIC_TAHTASI);
  const [secilenTas, setSecilenTas] = useState<TasTipi>("P");
  const [aktifMod, setAktifMod] = useState<"analiz" | "olusturucu">("analiz");
  const [mesaj, setMesaj] = useState("Tahta üzerindeki karelere tıklayarak seçili taşı yerleştirebilir veya analiz edebilirsin.");

  function handleKareTikla(r: number, c: number) {
    const yeniTahta = tahta.map(row => [...row]);
    yeniTahta[r][c] = secilenTas;
    setTahta(yeniTahta);
  }

  function tasGoster(kod: string) {
    const taslar: Record<string, string> = {
      R: "♖", N: "♘", B: "♗", Q: "♕", K: "♔", P: "♙",
      r: "♜", n: "♞", b: "♝", q: "♛", k: "♚", p: "♟"
    };
    return taslar[kod] || "";
  }

  function tahtayiSifirla() {
    setTahta(BASLANGIC_TAHTASI);
    setMesaj("Tahta başlangıç konumuna sıfırlandı.");
  }

  function tahtayiTemizle() {
    const bosTahta: TasTipi[][] = Array.from({ length: 8 }, () => Array(8).fill("."));
    setTahta(bosTahta);
    setMesaj("Tahta tamamen temizlendi. İstediğin pozisyonu kurabilirsin.");
  }

  return (
    <div
      style={{
        maxWidth: "750px",
        width: "100%",
        backgroundColor: "#ffffff",
        padding: "24px",
        borderRadius: "24px",
        border: "3px solid #0284c7",
        boxShadow: "0 10px 30px rgba(2, 132, 199, 0.1)",
        margin: "0 auto",
        textAlign: "center",
      }}
    >
      <span style={{ fontSize: "40px" }}>🛠️♟️</span>
      <h1 style={{ fontSize: "22px", fontWeight: "900", color: "#0369a1", margin: "6px 0" }}>
        Satranç Tahta Yapıcı & Analiz Stüdyosu
      </h1>
      <p style={{ fontSize: "13px", color: "#64748b", margin: "0 0 16px 0" }}>
        Kendi oyun pozisyonlarını tasarla, bulmacalar oluştur veya tahtayı serbestçe analiz et!
      </p>

      {/* Mod Seçimi */}
      <div style={{ display: "flex", justifyContent: "center", gap: "10px", marginBottom: "16px" }}>
        <button
          type="button"
          onClick={() => { setAktifMod("analiz"); setMesaj("Analiz modundasınız. Pozisyonu inceleyebilirsiniz."); }}
          style={{
            padding: "8px 16px",
            backgroundColor: aktifMod === "analiz" ? "#0284c7" : "#f1f5f9",
            color: aktifMod === "analiz" ? "#ffffff" : "#334155",
            borderRadius: "10px",
            border: "none",
            fontWeight: "900",
            fontSize: "12px",
            cursor: "pointer",
          }}
        >
          🔍 Pozisyon Analizi
        </button>

        <button
          type="button"
          onClick={() => { setAktifMod("olusturucu"); setMesaj("Oyun Oluşturucu modundasınız. Aşağıdan taş seçip tahtaya yerleştirin."); }}
          style={{
            padding: "8px 16px",
            backgroundColor: aktifMod === "olusturucu" ? "#10b981" : "#f1f5f9",
            color: aktifMod === "olusturucu" ? "#ffffff" : "#334155",
            borderRadius: "10px",
            border: "none",
            fontWeight: "900",
            fontSize: "12px",
            cursor: "pointer",
          }}
        >
          ✍️ Oyun / Bulmaca Kurucu
        </button>
      </div>

      <div style={{ backgroundColor: "#f0f9ff", border: "2px solid #bae6fd", borderRadius: "12px", padding: "10px", fontSize: "12px", color: "#0369a1", fontWeight: "bold", marginBottom: "16px" }}>
        💡 {mesaj}
      </div>

      {/* Taş Paleti (Oluşturucu Modda Aktif) */}
      {aktifMod === "olusturucu" && (
        <div style={{ backgroundColor: "#f8fafc", padding: "12px", borderRadius: "14px", border: "1px solid #e2e8f0", marginBottom: "16px" }}>
          <div style={{ fontSize: "11px", fontWeight: "900", color: "#475569", marginBottom: "8px" }}>
            YERLEŞTİRMEK İÇİN BİR TAŞ SEÇİN:
          </div>
          <div style={{ display: "flex", justifyContent: "center", gap: "6px", flexWrap: "wrap" }}>
            {(["R", "N", "B", "Q", "K", "P", "r", "n", "b", "q", "k", "p", "."] as TasTipi[]).map((t) => (
              <button
                key={t}
                type="button"
                onClick={() => setSecilenTas(t)}
                style={{
                  width: "36px",
                  height: "36px",
                  fontSize: "20px",
                  backgroundColor: secilenTas === t ? "#dcfce7" : "#ffffff",
                  border: secilenTas === t ? "2px solid #10b981" : "1px solid #cbd5e1",
                  borderRadius: "8px",
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                }}
              >
                {t === "." ? "📭" : tasGoster(t)}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* TAHTA GÖRÜNÜMÜ */}
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(8, 1fr)",
          width: "340px",
          height: "340px",
          margin: "0 auto 16px auto",
          border: "4px solid #78350f",
          borderRadius: "10px",
          boxShadow: "0 8px 20px rgba(0,0,0,0.15)",
        }}
      >
        {tahta.map((satir, r) =>
          satir.map((tas, c) => {
            const beyazKare = (r + c) % 2 === 0;
            return (
              <div
                key={`${r}-${c}`}
                onClick={() => handleKareTikla(r, c)}
                style={{
                  backgroundColor: beyazKare ? "#fef08a" : "#ca8a04",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: "30px",
                  cursor: "pointer",
                  userSelect: "none",
                }}
              >
                {tasGoster(tas)}
              </div>
            );
          })
        )}
      </div>

      {/* Kontrol Butonları */}
      <div style={{ display: "flex", justifyContent: "center", gap: "10px", marginBottom: "20px", flexWrap: "wrap" }}>
        <button
          type="button"
          onClick={tahtayiSifirla}
          style={{ padding: "8px 14px", backgroundColor: "#f59e0b", color: "#ffffff", borderRadius: "10px", border: "none", fontWeight: "bold", fontSize: "11px", cursor: "pointer" }}
        >
          🔄 Başlangıç Konumuna Getir
        </button>
        <button
          type="button"
          onClick={tahtayiTemizle}
          style={{ padding: "8px 14px", backgroundColor: "#ef4444", color: "#ffffff", borderRadius: "10px", border: "none", fontWeight: "bold", fontSize: "11px", cursor: "pointer" }}
        >
          🧹 Tahtayı Temizle
        </button>
      </div>

      <div style={{ display: "flex", justifyContent: "center", gap: "10px" }}>
        <Link
          href="/"
          style={{ padding: "8px 14px", backgroundColor: "#0284c7", color: "#ffffff", borderRadius: "10px", textDecoration: "none", fontWeight: "bold", fontSize: "11px" }}
        >
          🏠 Bot Oyunu
        </Link>
        <Link
          href="/dersler"
          style={{ padding: "8px 14px", backgroundColor: "#10b981", color: "#ffffff", borderRadius: "10px", textDecoration: "none", fontWeight: "bold", fontSize: "11px" }}
        >
          🎓 Dersler
        </Link>
      </div>
    </div>
  );
}

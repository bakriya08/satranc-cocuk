// Football-Data.org API Entegrasyonu (Süper Lig / TR1)
const API_TOKEN = 'BURAYA_API_KEY_YAZIN'; // football-data.org sitesinden ücretsiz alabilirsiniz

// 1. Gerçek Puan Durumunu Çekme
async function fetchStandings() {
  try {
    const response = await fetch('https://api.football-data.org/v4/competitions/TR1/standings', {
      headers: { 'X-Auth-Token': API_TOKEN }
    });
    const data = await response.json();
    
    // Süper Lig Puan Tablosu
    const standings = data.standings[0].table;
    renderStandings(standings);
  } catch (error) {
    console.error("Puan durumu çekilemedi:", error);
  }
}

